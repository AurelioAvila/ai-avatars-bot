# Local lip-sync engine: cloned third-party repo (its own .git, several GB
# of model weights once installed) + its own Python 3.10 venv - none of this
# belongs in this project's own git history, it's fetched via
# `git clone https://github.com/anothermartz/Easy-Wav2Lip.git lipsync_engine`
# + `python install.py` per lipsync_local.py's docstring instead.
lipsync_venv/
lipsync_engine/

# Test/scratch outputs from local runs, not real content
output/final/*.ass
output/final/*_metadata.json
output/scripts/*.json
output/audio/*.mp3
output/audio/*.json

# Contains real Telegram/TikTok credentials set inline (Scheduled Task
# processes don't reliably see Windows user env vars without a logoff/logon,
# see lipsync_local.py commit history) - never belongs in a public repo.
run_daily.bat

.DS_Store
Thumbs.db
